# All optional; the defaults work for a typical laptop webcam. Copy to .env and export the values
# you change (the app reads the process environment, it does not load .env itself).
# Which camera to open (0 is the built-in one).
CAMERA_INDEX=0
# Thumb-to-index distance as a fraction of your hand size (wrist to middle-finger knuckle) that means
# 0% and 100% volume. Lower MAX if you cannot reach 100%, raise MIN if 0% is hard to hit.
PINCH_MIN_RATIO=0.15
PINCH_MAX_RATIO=1.0
# Smoothing of the pinch signal: weight of the newest frame, above 0 up to 1. 1 is off; lower is steadier but lags.
SMOOTHING_ALPHA=0.4
# Key that freezes the volume at its current value and unfreezes it again (preview window focused). One character.
LOCK_KEY=l
# Key that starts a 5-second calibration of your own pinch range, and where the range is saved.
CALIBRATE_KEY=c
CALIBRATION_SECONDS=5
# CALIBRATION_FILE=C:/Users/you/.hand-gesture-volume-control/calibration.json
# Fist (mute) thresholds, fitted on recorded hands (tools/fit_fist.py). Lower them if it mutes by mistake.
FIST_MAX_EXTENSION=0.77
FIST_MAX_THUMB_REACH=0.56
# Frames in a row a fist must be held before it toggles mute.
MUTE_HOLD_FRAMES=10
# Hands to look for (the first one controls the volume) and detection threshold, 0 to 1.
MAX_HANDS=1
DETECTION_CONFIDENCE=0.5
# Background mode (also --background): no preview window, Ctrl+Alt plus the lock, calibrate and quit
# keys work from any window, and a small indicator shows the volume for a few seconds after a change.
BACKGROUND=0
QUIT_KEY=q
INDICATOR_SECONDS=2
