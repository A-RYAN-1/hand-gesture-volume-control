# All optional; the defaults work for a typical laptop webcam. Copy to .env and export the values
# you change (the app reads the process environment, it does not load .env itself).
# Which camera to open (0 is the built-in one).
CAMERA_INDEX=0
# Thumb-to-index distance in pixels that means 0% and 100% volume. Raise MAX if you sit far away.
PINCH_MIN_PX=50
PINCH_MAX_PX=250
# Hands to look for (the first one controls the volume) and detection threshold, 0 to 1.
MAX_HANDS=1
DETECTION_CONFIDENCE=0.5
